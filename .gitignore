# API keys / secrets
.env
.env.*
!.env.example
*.key

# LLM response cache
.cache/llm/

# Outputs and bench results — ignore everything except REPORT.md.
# REPORT.md is a tracked deliverable (GuideLine §5 #2, referenced by
# README.md §8 and MASTER_PLAN.md §8). bench/run_all.sh regenerates it;
# commit when results change. Re-include only works if the parent dir
# itself isn't ignored, so we use `out/*` not `out/`.
out/*
!out/REPORT.md

# Build artifacts (xv6)
xv6-src/kernel/*.o
xv6-src/kernel/*.d
xv6-src/kernel/*.asm
xv6-src/kernel/*.sym
xv6-src/user/*.o
xv6-src/user/*.d
xv6-src/user/*.asm
xv6-src/user/*.sym
xv6-src/user/_*
xv6-src/user/initcode
xv6-src/user/initcode.out
xv6-src/user/usys.S
xv6-src/kernel/kernel
xv6-src/fs.img
xv6-src/mkfs/mkfs

# Editor / OS
*.swp
*.swo
.DS_Store
__pycache__/
*.pyc
*.pyo

# WSL Zone.Identifier files
*:Zone.Identifier

# Original harness drop-in (root-owned, superseded by root-level files)
files/

# Ralph Loop local session metadata
.claude/ralph-loop.local.md

# Local-only docs (progress report docx + its generator)
docs/Liberal_OS_Progress_Report.docx
docs/build_progress_report.py
