# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real keys.

UPSTAGE_API_KEY=up-xxxxxxxxxxxxxxxxxxxx

# Operating mode for proxy_daemon.py
#   live   — real Upstage API calls (demo only)
#   replay — cached responses only (required for benchmarks)
#   mock   — sleep + dummy responses (CI / autotest default)
MODE=mock
